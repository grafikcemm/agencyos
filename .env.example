# AgencyOS — Ortam Değişkenleri (ÖRNEK / template).
# Gerçek değerleri .env.local'a yazın (.env.local commit EDİLMEZ).
# Vercel'de aynı değişkenleri Project Settings → Environment Variables'a girin.

# ── Supabase (ZORUNLU) ───────────────────────────────────────────────
# Uygulama DB'si (Supabase proje ref'i: dfedeh…). MCP default projesi (xcqrk…) DEĞİL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key            # public anahtar — DB tarafı RLS ile korunmalı
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key        # GİZLİ — RLS'i bypass eder; asla client'a sızdırma

# ── Feed The Goat / Yaşam OS Supabase (ZORUNLU — hayat sayfaları) ───
# İKİNCİ Supabase projesi (ref: xcqrk…). Günlük/Gelişim/Akademi/Kütüphane/Finans
# sayfaları buradan okur. Uygulama DB'sinden (dfedeh…) ayrıdır.
NEXT_PUBLIC_LIFE_SUPABASE_URL=https://YOUR_LIFE_PROJECT.supabase.co
NEXT_PUBLIC_LIFE_SUPABASE_ANON_KEY=your_life_anon_key   # public anahtar
LIFE_SUPABASE_SERVICE_ROLE_KEY=your_life_service_role_key # GİZLİ — yalnızca server (server-only)

# ── Cron (ZORUNLU — agent-tick / daily-scan / job-scan / opportunity-scan) ──
CRON_SECRET=your_cron_bearer_secret                    # Vercel cron Authorization: Bearer <bu değer>

# ── AI / Zenginleştirme ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...                           # LLM (jarvis, lead analiz, cold-email, ASİSTAN)
# OPENROUTER_MODEL artık KULLANILMIYOR (Faz 5): asistan/mentor modeli merkezi
# preset registry'den gelir (src/lib/models/presets.ts, operation: assistant_chat);
# deploy'suz düzeltme settings.ai_route_presets override'ıyla yapılır.
# AI_GATEWAY_ENABLED de KULLANILMIYOR: asistan yolu artık HER ZAMAN gateway'den geçer.
BRAIN_V2_ENABLED=                                       # Faz 1 bayrağı — boş=KAPALI. 'true' iken Brain v2 shadow orkestrasyonu devreye girer (yalnız gözlem; write/dış-çağrı yok)
BRAIN_ACTIVE_ENABLED=                                   # Faz 3 bayrağı — boş=KAPALI. 'true' iken Brain v2 active mode: kanonik run/step yazar + güvenli read'leri yürütür + write/external/spend'i approval_requests'e gate'ler (onaysız gönderim/harcama yok)
GOOGLE_GEMINI_API_KEY=AIza...                          # opsiyonel — Gemini
GOOGLE_MAPS_KEY=AIza...                                # Lead Radar (Google Maps yer/yorum verisi)
APOLLO_API_KEY=...                                     # opsiyonel — lead enrichment
FIRECRAWL_API_KEY=fc-...                               # opsiyonel — web scraping
SERPAPI_API_KEY=...                                    # opsiyonel — arama (kanonik isim)
# SERPAPI_KEY=...                                      # LEGACY alias — kod `SERPAPI_API_KEY || SERPAPI_KEY` okur; yeni kurulumda SERPAPI_API_KEY kullan

# ── Asistan / Mentor (opsiyonel — Telegram proaktif bildirim + cron) ──
TELEGRAM_BOT_TOKEN=                                     # opsiyonel — Telegram bot (asistan proaktif mesaj)
TELEGRAM_CHAT_ID=                                       # opsiyonel — hedef/yetkili sohbet ID (webhook bu ID dışını yutar)
TELEGRAM_WEBHOOK_SECRET=                                # opsiyonel ama önerilir — setWebhook secret_token; webhook auth
TELEGRAM_USER_ID=                                       # ZORUNLU (webhook icin) — yetkili kullanici ID; yoksa inbound FAIL-CLOSED islenmez
ORCHESTRATOR_START_DATE=2026-06-01                      # asistan/orchestrator başlangıç tarihi (yyyy-MM-dd)
# ── Orchestrator / Telegram UI bayrakları (opsiyonel — NEXT_PUBLIC_, client'a gömülür) ──
NEXT_PUBLIC_TELEGRAM_CONNECTED=                         # boş=bağlı değil; herhangi truthy değer "Telegram bağlı" rozetini gösterir
NEXT_PUBLIC_ORCHESTRATOR_START=                         # boş ise UI "1 Haziran 2026" varsayılanını gösterir (görsel etiket)
NEXT_PUBLIC_SHOW_ORCHESTRATOR=                          # sadece "1" iken orchestrator panelini gösterir; aksi halde gizli
NEXT_PUBLIC_USD_TO_TL=                                   # opsiyonel — dashboard USD/TRY kuru (boş ise 38 varsayılır)

# ── Command Center dış kaynakları (opsiyonel — yoksa "down" gösterilir) ──
NEWS_AI_BASE_URL=                                       # opsiyonel — News-AI snapshot kaynağı
NEWS_AI_SNAPSHOT_TOKEN=                                 # opsiyonel
XAGENT_BASE_URL=                                        # opsiyonel — XAgent snapshot kaynağı
XAGENT_SNAPSHOT_TOKEN=                                  # opsiyonel
AGENCYOS_BASE_URL=                                      # opsiyonel — kendi snapshot endpoint'i

# ── Entegrasyonlar / Diğer ──────────────────────────────────────────
AGENCYOS_SNAPSHOT_TOKEN=your_snapshot_bearer_token     # Feed The Goat snapshot (PRODUCTION'da zorunlu)

# ── GrafikcemOS (CEMOS) LIFE köprüsü ────────────────────────────────
# DAR kimlik: OPERATOR_API_TOKEN / CRON_SECRET / service-role bu yoldan GEÇMEZ.
# Okuma ve yazma AYRI token: okuma tokenı sızsa bile hiçbir LIFE satırı değişmez.
# İkisi de tanımsızsa köprü HER ortamda 401 döner (dev'de açık kapı yok).
CEMOS_LIFE_CLIENT_ID=cemos                             # denetim kaydındaki istemci adı
CEMOS_LIFE_READ_TOKEN=                                 # yalnız okuma (snapshot/tasks/habits/capacity/reminders)
CEMOS_LIFE_WRITE_TOKEN=                                # okuma + yazma (görev/adım/alışkanlık logu)
LIFE_UI_OWNER=agencyos                                 # agencyos (varsayılan) | cemos — kişisel LIFE panelinin sahibi

# ── Growth motoru — lead kaynakları (RT-A4; hepsi default KAPALI) ────
# APIFY_ENABLED yalnız tam `true` iken açılır. Kapalıyken hiçbir Actor koşusu
# BAŞLATILMAZ (ağa çıkılmadan reddedilir). Aylık tavan $29 ve kodda zorunlu:
# tavanı aşacak koşu küçültülmez, tamamen reddedilir.
APIFY_ENABLED=false                                    # true = Apify lead kaynağı açık (para harcar)
APIFY_TOKEN=                                           # Apify API token
APIFY_ACTOR_ID=                                        # kullanılacak Actor kimliği (ör. owner~actor-name)
APIFY_COST_PER_1K_USD=                                 # ZORUNLU — tanımsızsa tahmin üretilemez ve bütçe kapısı koşuyu REDDEDER

# ── Growth motoru — gönderim sağlayıcısı (RT-A5; default KAPALI) ─────
# Instantly bir GÖNDERİM altyapısıdır, CRM DEĞİL: lead/kişi/teklif AgencyOS'ta
# kalır, oraya yalnız gönderim için gereken asgari alan gider. Kapalıyken hiçbir
# istek çıkmaz; kapalı+yapılandırılmamışken seçim Fake sağlayıcıya düşer ve
# tek bir gerçek mail bile gönderilmez.
INSTANTLY_ENABLED=false                                # true = Instantly gönderim sağlayıcısı açık
INSTANTLY_API_KEY=                                     # v2 API anahtarı (dar kapsamlı)
INSTANTLY_CAMPAIGN_ID=                                 # lead'in ekleneceği kampanya

# ── Growth motoru — email_pilot_v1 (RT-A6; default KAPALI) ───────────
# Pilot güvenceleri koddadır: warmup'sız gönderim yok, cap 5→10→20 kademeli,
# hard-pause koşulları enqueue yolunda. Bayrak kapalıyken pilot sırası hiçbir
# mesajı kuyruğa almaz; cockpit yalnız okur.
EMAIL_PILOT_ENABLED=false                              # true = email_pilot_v1 sırası aktif (gönderim yine sağlayıcı + insan onayına bağlı)

# ── Growth köprüsü — GrafikcemOS (RT-A7) ────────────────────────────
# LIFE köprüsünden AYRI tokenlar: LIFE tokenıyla growth verisine erişilemez ve
# tersi de geçerlidir. Snapshot PII TAŞIMAZ (anonim kimlik + sektör sinyali +
# maliyet bandı). Yazma yetkisi yalnız `proposed` öneri satırı üretir; hiçbir
# öneri kendiliğinden uygulanmaz, gönderim tetiklemez.
CEMOS_AGENCYOS_CLIENT_ID=cemos                         # denetim kaydındaki istemci adı
CEMOS_AGENCYOS_READ_TOKEN=                             # yalnız okuma (growth snapshot + öneri listesi)
CEMOS_AGENCYOS_WRITE_TOKEN=                            # okuma + öneri yazma
ALERT_WEBHOOK_URL=                                     # opsiyonel — uyarı webhook'u
NEXT_PUBLIC_APP_URL=http://localhost:3000              # opsiyonel — mutlak URL üretimi
APP_URL=                                                # gerçek pilotta ZORUNLU — Telegram webhook URL eşleşmesi (örn. https://agencyos.example)
VERCEL_PRO_PLAN_CONFIRMED=false                        # 13 sub-daily cron için plan yükseltme+deploy doğrulanınca true; Hobby'de false kalır
EXTERNAL_CRON_SCHEDULER_CONFIRMED=false                # GitHub Actions/Cloudflare gibi eşdeğer scheduler gerçek endpoint ile doğrulanınca true
LEAD_ACTION_RPC_REQUIRED=                               # opsiyonel — 'true': mig 058 canliyken legacy lead-action yolunu kapatir (fail-closed)
TELEGRAM_FAKE_TRANSPORT=                                # YALNIZ E2E — 'success' + BOS bot token: dis cagri olmadan sahte basari; token doluyken YOK SAYILIR
LOGIN_RATE_LIMIT=                                       # YALNIZ E2E/izole ortam — login brute-force limitini yükseltir; boş/tanımsız = prod default 8
PERSUASION_JUDGE_LIVE=                                  # YALNIZ operatör/batch — 1 ise persuasion judge CANLI model çağırır (CI daima fixture; boş bırak)

# ── Gmail OAuth + inbound ingest (FINALIZATION Faz 7 — kod hazır, dış konfig KULLANICI aksiyonu)
GOOGLE_CLIENT_ID=                                       # Google Cloud OAuth client (kullanıcı oluşturur; gerçek akış onaysız açılmaz)
GOOGLE_CLIENT_SECRET=                                   # OAuth client secret — yalnız env; asla repo/log
GMAIL_OAUTH_REDIRECT_URI=                               # ör. https://<app>/api/gmail/oauth/callback (Google console ile birebir)
GMAIL_INGEST_ENABLED=                                   # 'true' değilse ingest SHADOW modda (mutasyon/provider çağrısı yok)
GMAIL_INGEST_FAKE=                                      # YALNIZ izole E2E: 'body' → istek gövdesindeki fake inbound işlenir (gerçek OAuth env doluyken YOK SAYILIR)
# ── Recipient + Evidence Enrichment (FINAL PILOT BLOCKERS Faz 4) ─────
ENRICHMENT_ENABLED=                                     # 'true' değilse enrichment SHADOW modda (mutasyon yok)
ENRICHMENT_FAKE=                                        # YALNIZ izole E2E: 'body' → istek gövdesindeki fake kişi/kanıt (APOLLO_API_KEY doluyken YOK SAYILIR)
ENRICHMENT_MAX_LEADS=                                   # opsiyonel — bir koşuda işlenecek azami lead (varsayılan 8)
ENRICHMENT_MAX_APOLLO=                                  # opsiyonel — bir koşuda azami Apollo çağrısı (varsayılan 5; kredi koruması)
OPPORTUNITY_SCAN_ENABLED=false                         # opsiyonel — fırsat taraması anahtarı

# ── Lead Intelligence v2 ────────────────────────────────────────────
PAGESPEED_API_KEY=                                     # shadow/active mod için ZORUNLU (masaüstü audit + screenshot kanıt zinciri); yoksa v2 koşusu error ile atlanır
LEAD_INTELLIGENCE_V2_KILL=                             # opsiyonel — ACİL kapatma (1/true = v2 tamamen kapalı; açma settings'ten)

# ── AgencyOS V2 — Outreach bayrakları (Sprint 0; default KAPALI) ─────
GMAIL_SEND_ENABLED=false                               # true = gerçek Gmail gönderimi; false = dry-run (taslak/onay/suppression akışı çalışır, send mock)
GMAIL_CANARY_RECIPIENT=                                # yalnız operatörün kontrolündeki teknik test adresi; ticari gönderimde kullanılmaz
FOLLOWUP_FSM_ENABLED=false                             # follow-up state machine (Sprint 2 — şimdilik hep false)

# ── Operatör kimlik doğrulaması (Faz 1 — production'da fail-closed) ──
APP_AUTH_EMAIL=info@grafikcem.com                       # Üretimde erişimine izin verilen tek Google Workspace hesabı
AUTH_GOOGLE_REDIRECT_URI=                               # ör. https://<app>/api/auth/google/callback (Google Console ile birebir)
APP_SESSION_SECRET=                                    # PRODUCTION'da ZORUNLU — min 32 karakter; HMAC oturum/state imzası
APP_PASSWORD=                                          # YALNIZ izole E2E; production girişinde kullanılmaz
E2E_PASSWORD_AUTH=false                                # YALNIZ Playwright config true verir; production'da false/boş
LOCAL_OPERATOR_MODE=false                              # true YALNIZ lokal dev bypass (NODE_ENV=production'da hükümsüz)
OPERATOR_API_TOKEN=                                    # opsiyonel — script/E2E için Bearer token (min 32 karakter)

# ── E2E test DB (Faz 7.1 — Playwright suite YALNIZ ayrı test DB'sinde koşar) ──
E2E_SUPABASE_URL=                                      # ZORUNLU (E2E için) — ayrı Supabase branch/test projesi URL'i; production ref REDDEDİLİR
E2E_SUPABASE_ANON_KEY=                                 # test projesi anon key
E2E_SUPABASE_SERVICE_ROLE_KEY=                         # test projesi service-role key (yalnız e2e seed/cleanup)
