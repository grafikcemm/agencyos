# AgencyOS — Ortam Değişkenleri (ÖRNEK / template).
# Gerçek değerleri .env.local'a yazın (.env.local commit EDİLMEZ).
# Vercel'de aynı değişkenleri Project Settings → Environment Variables'a girin.

# ── Supabase (ZORUNLU) ───────────────────────────────────────────────
# Uygulama DB'si (Supabase proje ref'i: dfedeh…). MCP default projesi (xcqrk…) DEĞİL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key            # public anahtar — DB tarafı RLS ile korunmalı
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key        # GİZLİ — RLS'i bypass eder; asla client'a sızdırma

# ── Operatör Girişi (ZORUNLU — hafif şifre kapısı) ──────────────────
APP_PASSWORD=change_me_to_a_strong_password            # tek paylaşılan giriş parolası
APP_SESSION_SECRET=replace_with_32+_char_random_secret # HMAC oturum imza anahtarı (min 16, öneri 32+ karakter)

# ── Cron (ZORUNLU — agent-tick / daily-scan / job-scan / opportunity-scan) ──
CRON_SECRET=your_cron_bearer_secret                    # Vercel cron Authorization: Bearer <bu değer>

# ── AI / Zenginleştirme ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...                           # LLM (jarvis, lead analiz, cold-email)
GOOGLE_GEMINI_API_KEY=AIza...                          # opsiyonel — Gemini
GOOGLE_MAPS_KEY=AIza...                                # Lead Radar (Google Maps yer/yorum verisi)
APOLLO_API_KEY=...                                     # opsiyonel — lead enrichment
FIRECRAWL_API_KEY=fc-...                               # opsiyonel — web scraping
SERPAPI_API_KEY=...                                    # opsiyonel — arama

# ── Entegrasyonlar / Diğer ──────────────────────────────────────────
AGENCYOS_SNAPSHOT_TOKEN=your_snapshot_bearer_token     # Feed The Goat snapshot (PRODUCTION'da zorunlu)
ALERT_WEBHOOK_URL=                                     # opsiyonel — uyarı webhook'u
NEXT_PUBLIC_APP_URL=http://localhost:3000              # opsiyonel — mutlak URL üretimi
OPPORTUNITY_SCAN_ENABLED=false                         # opsiyonel — fırsat taraması anahtarı
